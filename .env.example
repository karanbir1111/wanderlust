# MongoDB (optional - defaults to docker-compose mongodb)
# MONGODB_URI=mongodb://mongodb:27017/wanderlust

# Redis (optional - defaults to docker-compose redis)
# REDIS_URL=redis://redis:6379

# JWT Secret - CHANGE THIS IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Backend URL
BACKEND_URL=http://localhost:5000

# Token Expiry
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie Max Age (in milliseconds)
ACCESS_COOKIE_MAXAGE=3600000
REFRESH_COOKIE_MAXAGE=604800000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Node Environment
NODE_ENV=development